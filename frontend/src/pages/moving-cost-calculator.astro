---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import LeadForm from '@/components/islands/LeadForm';
import { breadcrumbSchema } from '@/lib/schema';

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Get a quote', path: '/moving-cost-calculator/' }];
---
<BaseLayout
  title="Get a moving quote | Shiftify"
  description="Request a written Shiftify moving quote. We do not publish public prices — a specialist contacts you after you share your route."
  canonicalPath="/moving-cost-calculator/"
  jsonLd={[breadcrumbSchema(crumbs)]}
  quoteHref="#lead-form"
>
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1>Get a written moving quote</h1>
      <p class="lead">We do not run a public price calculator. Tell us where you are moving — our team contacts you and quotes in writing after a short survey.</p>
      <div class="card" style="max-width:720px;padding:22px;margin-top:22px">
        <LeadForm client:load context={{ source: 'quote-page' }} />
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  h1 { font-size: clamp(1.7rem, 3.4vw, 2.3rem); letter-spacing: -0.03em; margin: 14px 0 10px; }
  .lead { color: var(--color-slate-500); font-size: 0.95rem; max-width: 66ch; }
</style>
