---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTABand from '@/components/CTABand.astro';
import Icon from '@/components/Icon.astro';
import { breadcrumbSchema } from '@/lib/schema';

const guides = (await getCollection('guides'))
  .filter((g) => !g.data.draft)
  .sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate));
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Guides', path: '/guides/' }];
---
<BaseLayout
  title="Moving Guides — Checklists, Costs & Red Flags | Shiftify"
  description="Practical moving guides for India: how to verify a mover, intercity moving checklists, cost explainers and moving-day playbooks."
  canonicalPath="/guides/"
  jsonLd={[breadcrumbSchema(crumbs)]}
  quoteHref="/contact/#quote"
>
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1>Moving guides</h1>
      <p class="lead">Field notes from the operations side — written to make your next move cheaper, safer and shorter, whoever you book it with. Pair a guide with a city page such as <a href="/packers-and-movers-delhi/">Delhi</a>, <a href="/packers-and-movers-delhi/dwarka/">Dwarka</a> or <a href="/services/house-shifting/">home shifting</a>.</p>
      <div class="guide-grid">
        {guides.map((g) => (
          <a class="guide card card--pad-s" href={`/guides/${g.id.replace(/\.mdx?$/, '')}/`}>
            <span class="guide-tags">{g.data.tags.map((t) => <em>{t}</em>)}</span>
            <h2>{g.data.title}</h2>
            <p>{g.data.description}</p>
            <span class="guide-go">Read guide <Icon name="arrow" size={14} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CTABand heading="Read enough — ready for a quote?" sub="The guides make you a harder customer to fool. Our written quote handles itself." quoteHref="/#hero" />
</BaseLayout>
<style>
  h1 { font-size: clamp(1.7rem, 3.4vw, 2.4rem); letter-spacing: -0.03em; margin: 14px 0 12px; }
  .lead { color: var(--color-slate-500); font-size: 0.95rem; max-width: 70ch; }
  .guide-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-top: 26px; }
  .guide { display: flex; flex-direction: column; gap: 8px; }
  .guide:hover { border-color: var(--color-line-blue); }
  .guide h2 { font-size: 1.02rem; letter-spacing: -0.01em; }
  .guide p { font-size: 0.84rem; color: var(--color-slate-500); flex: 1; }
  .guide-tags { display: flex; gap: 6px; }
  .guide-tags em { font-style: normal; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-blue-600); border: 1px solid var(--color-line-blue); padding: 3px 8px; border-radius: 3px; }
  .guide-go { display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; font-weight: 600; color: var(--color-blue-600); }
  @media (max-width: 720px) { .guide-grid { grid-template-columns: 1fr; } }
</style>
