---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FAQAccordion from '@/components/FAQAccordion.astro';
import CTABand from '@/components/CTABand.astro';
import { allCities } from '@/lib/data';
import { faqSchema, breadcrumbSchema } from '@/lib/schema';

const [faqEntries, cities] = await Promise.all([getCollection('faqs'), allCities()]);
const faqs = faqEntries.map((f) => f.data);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'FAQ', path: '/faq/' }];
---
<BaseLayout
  title="Packers and Movers FAQ — Pricing, Insurance, Process | Shiftify"
  description="Straight answers on packers and movers pricing, advance payments, transit insurance, claims, booking and move-day process in India."
  canonicalPath="/faq/"
  jsonLd={[faqSchema(faqs), breadcrumbSchema(crumbs)]}
  quoteHref="/contact/#quote"
>
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <h1>Frequently asked questions</h1>
      <p class="lead">General answers live here. For city-specific rules (society NOCs, truck timings, coverage), each city page carries its own FAQ:
        {cities.map((c, i) => <a class="cityq" href={`/packers-and-movers-${c.data.slug}/`}>{c.data.name}{i < cities.length - 1 ? ' · ' : ''}</a>)}
      </p>
      <FAQAccordion faqs={faqs} heading="" />
    </div>
  </section>
  <CTABand heading="Didn't find your answer?" sub="WhatsApp the question — a human replies in minutes during support hours." quoteHref="/contact/#quote" />
</BaseLayout>
<style>
  h1 { font-size: clamp(1.7rem, 3.4vw, 2.4rem); letter-spacing: -0.03em; margin: 14px 0 12px; }
  .lead { color: var(--color-slate-500); font-size: 0.95rem; max-width: 76ch; margin-bottom: 10px; }
  .cityq { color: var(--color-blue-600); font-weight: 600; }
</style>
