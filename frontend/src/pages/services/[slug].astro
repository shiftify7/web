---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FAQAccordion from '@/components/FAQAccordion.astro';
import CTABand from '@/components/CTABand.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import Icon from '@/components/Icon.astro';
import LeadForm from '@/components/islands/LeadForm';
import { allServices, allCities, type Service } from '@/lib/data';
import { serviceSchema, faqSchema, breadcrumbSchema } from '@/lib/schema';

export const getStaticPaths = (async () => {
  const services = await allServices();
  return services.map((service) => ({ params: { slug: service.data.slug }, props: { service } }));
}) satisfies GetStaticPaths;

const { service } = Astro.props as { service: Service };
const d = service.data;
const cities = await allCities();
// Branded scene for this service's hero (white-background renders generated
// from the supplied masters — see scripts and uploads/gen-white-bg).
import type { ImageMetadata } from 'astro';
const svcHeroAssets = import.meta.glob<{ default: ImageMetadata }>('../../assets/services/*-600.webp', { eager: true });
const heroImg = svcHeroAssets[`../../assets/services/${d.slug}-600.webp`]?.default;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: d.name, path: `/services/${d.slug}/` },
];
const jsonLd = [serviceSchema(service), faqSchema(d.faqs), breadcrumbSchema(crumbs)];
---
<BaseLayout
  title={d.metaTitle}
  description={d.metaDescription}
  canonicalPath={`/services/${d.slug}/`}
  jsonLd={jsonLd}
  quoteHref="#lead-form"
>
  <section class="svc-hero">
    <div class="wrap">
      <Breadcrumbs items={crumbs} class="crumbs-top" />
      <div class="svc-hero-grid">
        <div>
          <span class="kicker">Service</span>
          <h1>{d.name}</h1>
          <p class="svc-lead">{d.description}</p>
          <div class="svc-cta">
            <WhatsAppButton label={`WhatsApp about ${d.name.toLowerCase()}`} />
            <a href="#lead-form" class="btn btn--blue" data-event="quote_cta_click" data-event-position="service-hero">Get a Free Quote</a>
          </div>
        </div>
        {heroImg && (
          <figure class="svc-hero-fig" aria-hidden="true">
            <img
              src={heroImg.src}
              width={heroImg.width}
              height={heroImg.height}
              alt=""
              loading="eager"
              decoding="async"
            />
          </figure>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="kicker">What's included</span>
      <h2 class="flat-h">How we run a {d.name.toLowerCase()} job</h2>
      <div class="feat-grid">
        {
          d.features.map((f, i) => (
            <div class="card card--pad-s">
              <span class="feat-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap avail">
      <span class="kicker">Availability</span>
      <h2 class="flat-h">{d.name} in your city</h2>
      <div class="areas">
        {
          cities.map((c) => (
            <a class="area" href={`/packers-and-movers-${c.data.slug}/`}>
              <Icon name="pin" size={12} />{d.name} in {c.data.name}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap quote-split">
      <FAQAccordion faqs={d.faqs} heading={`${d.name} — FAQ`} />
      <div class="quote-col">
        <LeadForm client:load heading="Plan this move" context={{ source: `service:${d.slug}`, service: d.name }} />
      </div>
    </div>
  </section>

  <CTABand heading={`Book ${d.name.toLowerCase()} without the advance-payment anxiety`} sub="Written quote first. Payment on the quote's terms. That's the whole model." quoteHref="#lead-form" />
</BaseLayout>

<style>
  .svc-hero { padding: 22px 0 10px; background: var(--color-grey-25); }
  .crumbs-top { margin-bottom: 18px; }
  .svc-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: center; padding-bottom: 30px; }
  .svc-hero h1 { font-size: clamp(1.7rem, 3.4vw, 2.4rem); letter-spacing: -0.03em; margin: 12px 0 14px; }
  .svc-lead { color: var(--color-slate-500); font-size: 0.98rem; max-width: 66ch; }
  .svc-cta { display: flex; gap: 12px; margin-top: 22px; flex-wrap: wrap; }
  .svc-hero-fig {
    margin: 0; width: clamp(240px, 30vw, 380px);
    border: 1px solid var(--color-line); border-radius: var(--radius-m);
    background: #fff; padding: 6px; box-shadow: 0 20px 40px -26px rgba(30, 58, 138, 0.25);
  }
  .svc-hero-fig img { display: block; width: 100%; height: auto; }
  @media (max-width: 720px) {
    .svc-hero-grid { grid-template-columns: minmax(0, 1fr); }
    .svc-hero-fig { width: min(340px, 100%); margin-top: 8px; }
  }

  .flat-h { font-size: clamp(1.4rem, 2.6vw, 1.85rem); letter-spacing: -0.025em; margin-top: 12px; }
  .feat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-top: 22px; }
  .feat-grid h3 { font-size: 1rem; margin-bottom: 6px; }
  .feat-grid p { font-size: 0.86rem; color: var(--color-slate-500); }
  .feat-n { display: block; font-family: ui-monospace, Menlo, monospace; font-size: 0.72rem; letter-spacing: 0.14em; color: var(--color-blue-600); margin-bottom: 10px; }
  @media (max-width: 720px) { .feat-grid { grid-template-columns: 1fr; } }

  .avail .areas { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 9px; }
  .area {
    display: inline-flex; align-items: center; gap: 7px;
    border: 1px solid var(--color-line); background: #fff; border-radius: var(--radius-xs);
    padding: 9px 13px; font-size: 0.82rem; font-weight: 600; color: var(--color-ink-900);
  }
  .area:hover { border-color: var(--color-blue-600); }

  .quote-split { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(24px, 4vw, 48px); align-items: start; }
  .quote-col { min-width: 0; width: 100%; }
  @media (max-width: 860px) { .quote-split { grid-template-columns: 1fr; } }
</style>
