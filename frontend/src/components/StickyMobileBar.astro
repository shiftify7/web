---
import { waLink, waMessageFor, telHref } from '@/consts';
import Icon from './Icon.astro';

/**
 * Sticky mobile bottom bar — pure CSS (visibility + layout), zero JS.
 * Appears under 760px via media query in global.css.
 */
interface Props {
  city?: string;
  quoteHref?: string;
}
const { city, quoteHref = '/#hero' } = Astro.props;
const wa = waLink(waMessageFor({ city })) || '/contact/';
const tel = telHref() || '/contact/';
---
<nav class="mbar" aria-label="Quick actions">
  <a href={tel} data-event="call_click" data-event-position="sticky-bar">
    <Icon name="phone" size={18} />Call
  </a>
  <a href={wa} class="mbar-wa" data-event="whatsapp_click" data-event-position="sticky-bar" {...wa.startsWith('https://') ? { target: '_blank', rel: 'noopener' } : {}}>
    <Icon name="wa" size={18} />WhatsApp
  </a>
  <a href={quoteHref} class="mbar-q" data-event="quote_cta_click" data-event-position="sticky-bar">
    <Icon name="receipt" size={18} />Get Quote
  </a>
</nav>
