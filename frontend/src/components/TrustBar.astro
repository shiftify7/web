---
import { SITE } from '@/consts';
import Icon from './Icon.astro';

interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---
<div class:list={['trustbar', dark && 'trustbar--dark']} role="list" aria-label="Why Shiftify is trustworthy">
  {SITE.gstin && <span role="listitem"><Icon name="shield-check" size={15} />GST Verified</span>}
  {SITE.insuranceCover && <span role="listitem"><Icon name="shield" size={15} />Transit Insured {SITE.insuranceCover}</span>}
  <span role="listitem"><Icon name="receipt" size={15} />No Advance Payment</span>
  {SITE.supportHours && <span role="listitem"><Icon name="clock" size={15} />{SITE.supportHours} Support</span>}
  {SITE.movesCompleted && <span role="listitem"><Icon name="box" size={15} />{SITE.movesCompleted} Moves Completed</span>}
</div>

<style>
  .trustbar {
    display: flex; flex-wrap: wrap; gap: 1px;
    background: var(--color-line); border: 1px solid var(--color-line);
    border-radius: var(--radius-s); overflow: hidden;
  }
  .trustbar span {
    flex: 1; min-width: 160px; background: #fff;
    padding: 13px 16px; font-size: 0.8rem; font-weight: 600; color: var(--color-navy-800);
    display: flex; gap: 9px; align-items: center;
  }
  .trustbar svg { width: 15px; height: 15px; color: var(--color-blue-600); flex: none; }
  .trustbar--dark { background: rgba(255, 255, 255, 0.14); border-color: rgba(255, 255, 255, 0.14); }
  .trustbar--dark span { background: var(--color-ink-850); color: #dce7fb; }
</style>
