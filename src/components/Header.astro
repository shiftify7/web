---
import { Image } from 'astro:assets';
import logo from '@/assets/logo-word.png';
import { allServices } from '@/lib/data';
import WhatsAppButton from './WhatsAppButton.astro';
import MobileNav from './islands/MobileNav';

const services = await allServices();

const navServiceLinks = services.map((s) => ({
  label: s.data.name,
  href: `/services/${s.data.slug}/`,
}));
---
<header class="site-header">
  <div class="wrap header-in">
    <a href="/" class="brand" aria-label="Shiftify — home">
      <Image src={logo} alt="Shiftify Packers and Movers" width={140} height={39} loading="eager" decoding="async" />
    </a>

    <nav class="nav-desk" aria-label="Primary">
      <div class="nav-item">
        <a href="/services/" class="nav-link" aria-haspopup="true">Services</a>
        <div class="nav-drop nav-drop--grid" role="menu">
          {navServiceLinks.map((l) => <a href={l.href} role="menuitem">{l.label}</a>)}
        </div>
      </div>
      <a href="/about/" class="nav-link">About</a>
      <a href="/reviews/" class="nav-link">Reviews</a>
      <a href="/faq/" class="nav-link">FAQ</a>
      <a href="/contact/" class="nav-link">Contact</a>
    </nav>

    <div class="header-cta">
      <WhatsAppButton label="WhatsApp Us" />
    </div>

    <div class="header-mobile">
      <MobileNav client:load services={navServiceLinks} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: saturate(1.2) blur(6px);
    border-bottom: 1px solid var(--color-line);
  }
  .header-in {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    gap: 14px; height: 68px;
  }
  /* three zones: brand pinned to the left corner, nav centered, CTAs to the
     right corner — regardless of how wide any one side is */
  .brand { display: inline-flex; align-items: center; min-width: 0; grid-column: 1; justify-self: start; }
  .brand img { width: 130px; height: auto; }
  .nav-desk { display: flex; align-items: center; gap: 0px; grid-column: 2; justify-self: center; }
  .nav-link {
    padding: 9px 12px; font-size: 0.88rem; font-weight: 600; color: var(--color-ink-900);
    border-radius: var(--radius-s);
  }
  .nav-link:hover { color: var(--color-blue-600); background: var(--color-blue-50); }
  .nav-item { position: relative; }
  .nav-item > .nav-link::after {
    content: ""; display: inline-block; margin-left: 6px; vertical-align: 2px;
    border: solid var(--color-slate-400); border-width: 0 1.5px 1.5px 0; padding: 2.2px; transform: rotate(45deg);
  }
  .nav-drop {
    position: absolute; top: calc(100% + 6px); left: 0; min-width: 280px;
    background: #fff; border: 1px solid var(--color-line); border-radius: var(--radius-m);
    box-shadow: 0 24px 48px -16px rgba(7, 13, 31, 0.25); padding: 8px;
    display: none; z-index: 60;
  }
  .nav-item:hover .nav-drop, .nav-item:focus-within .nav-drop { display: block; }
  .nav-drop a {
    display: block; padding: 9px 12px; font-size: 0.86rem; font-weight: 600; color: var(--color-ink-900);
    border-radius: var(--radius-xs); white-space: nowrap;
  }
  .nav-drop a:hover { background: var(--color-blue-50); color: var(--color-blue-600); }
  .nav-drop--grid { grid-template-columns: 1fr 1fr; column-gap: 4px; min-width: 420px; }
  .nav-drop--grid.show, .nav-item:hover .nav-drop--grid, .nav-item:focus-within .nav-drop--grid { display: grid; }
  .drop-all { color: var(--color-blue-600) !important; border-top: 1px solid var(--color-line); margin-top: 4px; }
  .header-cta { display: flex; align-items: center; gap: 10px; grid-column: 3; justify-self: end; }
  .header-cta .btn { min-height: 44px; padding: 10px 18px; font-size: 0.88rem; }
  .header-phone { display: inline-flex; align-items: center; gap: 8px; }
  .header-mobile { display: none; grid-column: 3; justify-self: end; }

  @media (max-width: 1100px) {
    .nav-desk { display: none; }
    /* CTA children are rendered by nested components (no scoped attribute),
       so target them through :global — otherwise these hides never match. */
    .header-cta :global(.btn--ghost) { display: none; }
  }
  @media (max-width: 640px) {
    /* clean mobile bar: brand + hamburger; conversions live on the sticky bar */
    .header-cta { display: none; }
    .header-mobile { display: block; }
  }
</style>
