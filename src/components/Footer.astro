---
import { Image } from 'astro:assets';
import logo from '@/assets/logo-word.png';
import { SITE } from '@/consts';
import { allCities, allServices, allRoutes, routeSlug } from '@/lib/data';
import Placeholder from './Placeholder.astro';
import PhoneNumber from './PhoneNumber.astro';
import Icon from './Icon.astro';

const [cities, services, routes] = await Promise.all([allCities(), allServices(), allRoutes()]);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a href="/" class="foot-logo-chip" aria-label="Shiftify — home">
          <Image src={logo} alt="Shiftify Packers and Movers" width={152} height={42} loading="lazy" decoding="async" />
        </a>
        <p class="foot-blurb">
          Transparent, insured, on-time packers and movers — built for people who have been burned by this industry before.
        </p>
        <div class="foot-legal">
          <p><strong>{SITE.tradeName}</strong> {SITE.legalEntity ? `(${SITE.legalEntity})` : <Placeholder label="LEGAL ENTITY" dark />}</p>
          <p>GSTIN: {SITE.gstin || <Placeholder label="GSTIN" dark />}</p>
          <p>{SITE.hqAddress || <Placeholder label="HQ ADDRESS" dark />}</p>
        </div>
      </div>

      <div class="foot-col">
        <h2 class="foot-h">Contact</h2>
        <ul>
          <li><PhoneNumber withIcon class="foot-contact" dark /></li>
          <li>
            <a href="/contact/" data-event="whatsapp_click" class="foot-contact">
              <Icon name="wa" size={16} />{SITE.whatsappIntl ? `+${SITE.whatsappIntl}` : <Placeholder label="WHATSAPP" dark />}
            </a>
          </li>
          <li>
            <a href="/contact/" class="foot-contact">
              <Icon name="mail" size={16} />{SITE.email || <Placeholder label="EMAIL" dark />}
            </a>
          </li>
          <li class="foot-hours"><Icon name="clock" size={16} />Support: {SITE.supportHours || <Placeholder label="HOURS" dark />}</li>
        </ul>
      </div>

      <div class="foot-col">
        <h2 class="foot-h">Services</h2>
        <ul>
          {services.map((s) => <li><a href={`/services/${s.data.slug}/`}>{s.data.name}</a></li>)}
        </ul>
      </div>

      <div class="foot-col">
        <h2 class="foot-h">Cities</h2>
        <ul>
          {cities.map((c) => <li><a href={`/packers-and-movers-${c.data.slug}/`}>Packers and Movers in {c.data.name}</a></li>)}
          <li><a href="/cities/" class="foot-more">All cities →</a></li>
        </ul>
      </div>

      <div class="foot-col">
        <h2 class="foot-h">Company &amp; Legal</h2>
        <ul>
          <li><a href="/about/">About Shiftify</a></li>
          <li><a href="/reviews/">Reviews</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="/guides/">Moving guides</a></li>
          <li><a href="/cities/">Cities we serve</a></li>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
          <li><a href="/terms/">Terms of service</a></li>
          <li><a href="/refund-policy/">Refund &amp; cancellation</a></li>
          <li><a href="/disclaimer/">Disclaimer</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-routes">
      <h2 class="foot-h">Popular routes</h2>
      <div class="foot-route-links">
        {
          routes.map(async (r) => (
            <a href={`/${await routeSlug(r)}/`}>
              {r.data.from.replace(/-/g, ' ')} → {r.data.to.replace(/-/g, ' ')}
            </a>
          ))
        }
      </div>
    </div>

    <div class="foot-bottom">
      <p>© {year} {SITE.tradeName}. All rights reserved.</p>
      <p class="foot-lang">English (India) · हिन्दी version coming soon</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-ink-900); color: #94a5c4; }
  .site-footer .wrap { padding-block: clamp(48px, 6vw, 72px) 28px; }
  .foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 1.1fr; gap: 32px; }
  .foot-logo-chip { display: inline-flex; background: #ffffff; border-radius: 6px; padding: 9px 14px; margin-left: -14px; }
  .foot-logo-chip img { width: 160px; height: auto; }
  .foot-blurb { font-size: 0.86rem; margin: 16px 0 18px; max-width: 34ch; }
  .foot-legal { font-size: 0.8rem; display: grid; gap: 6px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 16px; }
  .foot-legal strong { color: #fff; }
  .foot-h { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; margin-bottom: 14px; }
  .foot-col ul { list-style: none; display: grid; gap: 9px; font-size: 0.86rem; }
  .foot-col a { color: #94a5c4; }
  .foot-col a:hover { color: #fff; }
  .foot-more { color: #8fb0ff !important; font-weight: 600; }
  .foot-contact { display: inline-flex; align-items: center; gap: 8px; }
  .foot-hours { display: inline-flex; align-items: center; gap: 8px; font-size: 0.84rem; }
  .foot-routes { margin-top: 40px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 24px; }
  .foot-route-links { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 0.8rem; text-transform: capitalize; }
  .foot-route-links a { color: #7e96c8; }
  .foot-route-links a:hover { color: #fff; }
  .foot-bottom {
    margin-top: 32px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 22px;
    display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; font-size: 0.78rem;
  }
  .foot-lang { color: #7e96c8; }
  @media (max-width: 1000px) { .foot-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .foot-grid { grid-template-columns: 1fr; } }
</style>
