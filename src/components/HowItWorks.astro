---

const STEPS = [
  { n: 1, title: 'Share your details', text: 'Cities, home size, date — on the form, on WhatsApp, or on a call. Two minutes, no commitment.' },
  { n: 2, title: 'Get a transparent quote', text: 'A short survey, then an itemised written quote. Every line explained; no obligation to book.' },
  { n: 3, title: 'Confirm your booking', text: 'No booking advance. We lock the date, crew, vehicle — and society lift slots where needed.' },
  { n: 4, title: 'We move you', text: 'Supervisor-led packing, sealed loading, proactive updates, and a bill that matches the written quote.' },
] as const;
---
<div class="steps" role="list">
  {
    STEPS.map((s) => (
      <div class="step" role="listitem">
        <span class="step-n" aria-hidden="true">{s.n}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </div>
    ))
  }
</div>

<style>
  .steps {
    position: relative;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 22px;
    counter-reset: step;
  }
  /* dashed route rail threading through the number nodes */
  .steps::before {
    content: ""; position: absolute; z-index: 0;
    top: 17px; left: -22px; right: -22px;
    border-top: 2px dashed var(--color-line-blue);
    mask: linear-gradient(90deg, transparent, #000 28px, #000 calc(100% - 28px), transparent);
    -webkit-mask: linear-gradient(90deg, transparent, #000 28px, #000 calc(100% - 28px), transparent);
  }
  .step {
    position: relative; z-index: 1;
    padding: 42px 18px 18px; border: 1px solid var(--color-line); border-radius: var(--radius-m);
    background: #fff;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }
  .step:hover { transform: translateY(-3px); border-color: var(--color-line-blue); box-shadow: 0 16px 32px -22px rgba(30, 58, 138, 0.3); }
  .step-n {
    position: absolute; top: 17px; left: 18px; transform: translateY(-50%);
    display: grid; place-items: center; width: 34px; height: 34px;
    background: var(--color-navy-800); color: #fff; font-weight: 700; font-size: 0.9rem;
    border-radius: var(--radius-xs); font-variant-numeric: tabular-nums;
    border: 3px solid #fff; box-shadow: 0 0 0 1px var(--color-line-blue);
  }
  .step h3 { font-size: 0.96rem; }
  .step h3::after { content: " →"; color: var(--color-blue-600); font-weight: 400; }
  .step:last-child h3::after { content: none; }
  .step p { font-size: 0.84rem; color: var(--color-slate-500); margin-top: 5px; }
  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr 1fr; }
    .steps::before { display: none; }
    .step { padding-top: 38px; }
  }
  @media (max-width: 480px) { .steps { grid-template-columns: 1fr; } }
</style>
