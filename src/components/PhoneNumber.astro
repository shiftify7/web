---
import { SITE, telHref } from '@/consts';
import Placeholder from './Placeholder.astro';
import Icon from './Icon.astro';

/**
 * Renders the tracked phone link. The data-sfx-phone attribute is the seam
 * where dynamic number insertion (call tracking by gclid/utm) can be wired
 * later without touching call sites.
 */
interface Props {
  withIcon?: boolean;
  label?: string;
  class?: string;
  dark?: boolean;
}
const { withIcon = false, label, class: cls = '', dark = false } = Astro.props;
const href = telHref();
---
{
  href ? (
    <a href={href} class={cls} data-sfx-phone data-event="call_click" rel="nofollow">
      {withIcon && <Icon name="phone" size={16} />}
      {label ?? SITE.phoneDisplay}
    </a>
  ) : (
    <span class={cls} data-sfx-phone>
      {withIcon && <Icon name="phone" size={16} />}
      <Placeholder label="PHONE" dark={dark} />
    </span>
  )
}
