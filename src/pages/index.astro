<script is:inline>
/* Quote popup controller: every quote CTA on this page (`#lead-section` or
   `/#lead-section` links — hero bar, services slides, mid-page panel, final
   CTA band, sticky mobile bar, fallbacks) opens the modal instead of
   scrolling; the hero quick-quote bar fires `sfx:quote-open` directly.
   Esc / scrim / × closes; focus is restored to the trigger. */
(function () {
  var modal = document.getElementById('lead-modal');
  if (!modal) return;
  var lastFocus = null;
  function open() {
    if (!modal.classList.contains('open')) lastFocus = document.activeElement;
    modal.classList.add('open');
    modal.removeAttribute('hidden');
    document.documentElement.style.overflow = 'hidden';
    var x = document.getElementById('lead-modal-x');
    if (x) x.focus();
  }
  function close() {
    modal.classList.remove('open');
    document.documentElement.style.overflow = '';
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }
  document.addEventListener('click', function (e) {
    var t = e.target;
    var a = t && t.closest ? t.closest('a[href="#lead-section"], a[href="/#lead-section"]') : null;
    if (a) {
      e.preventDefault();
      open();
      window.setTimeout(function () {
        var name = document.getElementById('lf-name');
        if (name) name.focus({ preventScroll: true });
      }, 300);
    }
  });
  modal.addEventListener('click', function (e) {
    var t = e.target;
    if (t.closest && (t.closest('[data-lead-close]') || t.closest('#lead-modal-x'))) close();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && modal.classList.contains('open')) close();
  });
  window.addEventListener('sfx:quote-open', open);
  if (location.hash === '#lead-section') open();
})();
</script>

<script is:inline>
/* Scroll-reveal for the spot illustrations: vanilla IntersectionObserver,
     adds .rv-in once, unobserves immediately. Reduced-motion users get
     instant-on via the CSS guard (no JS effect either way). ~0.4 KB inline. */
  (function () {
    try {
      const targets = document.querySelectorAll('[data-reveal]');
      if (!targets.length) return;
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        targets.forEach((el) => el.classList.add('rv-in'));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('rv-in');
            io.unobserve(entry.target);
          });
        },
        { threshold: 0.16, rootMargin: '0px 0px -6% 0px' },
      );
      targets.forEach((el) => io.observe(el));
    } catch (e) { /* illustrations stay visible via CSS fallback styles below */ }
  })();
</script>
