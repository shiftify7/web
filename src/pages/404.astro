---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { allCities } from '@/lib/data';
const cities = await allCities();
---
<BaseLayout
  title="Page Not Found (404)"
  description="This page doesn't exist — but our city pages might have what you were looking for."
  canonicalPath="/404/"
  noindex
  quoteHref="/#lead-section"
>
  <section class="section nf">
    <div class="wrap">
      <p class="nf-code">404</p>
      <h1>Wrong address — happens to the best of us.</h1>
      <p class="nf-sub">The page you wanted isn't here. These are:</p>
      <div class="nf-grid">
        <a class="card card--pad-s nf-card" href="/"><Icon name="home" size={18} /><span><b>Home</b><small>shiftify.in</small></span></a>
        <a class="card card--pad-s nf-card" href="/#lead-section"><Icon name="receipt" size={18} /><span><b>Free quote</b><small>callback in 30 min</small></span></a>
        <a class="card card--pad-s nf-card" href="/cities/"><Icon name="pin" size={18} /><span><b>Cities we serve</b><small>find your city</small></span></a>
        <a class="card card--pad-s nf-card" href="/contact/"><Icon name="wa" size={18} /><span><b>Contact</b><small>WhatsApp / call / form</small></span></a>
      </div>
      <p class="nf-cities">
        {cities.map((c, i) => <a href={`/packers-and-movers-${c.data.slug}/`}>Packers and Movers in {c.data.name}{i < cities.length - 1 ? ' · ' : ''}</a>)}
      </p>
    </div>
  </section>
</BaseLayout>
<style>
  .nf { text-align: center; }
  .nf-code { font: 800 clamp(3rem, 8vw, 5rem)/1 var(--font-sora); letter-spacing: -0.04em; color: var(--color-blue-600); }
  .nf h1 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); letter-spacing: -0.02em; margin: 10px 0 8px; }
  .nf-sub { color: var(--color-slate-500); }
  .nf-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 28px auto; max-width: 900px; text-align: left; }
  .nf-card { display: flex; gap: 12px; align-items: center; }
  .nf-card svg { color: var(--color-blue-600); flex: none; }
  .nf-card b { font-size: 0.9rem; display: block; }
  .nf-card small { color: var(--color-slate-500); font-size: 0.76rem; }
  .nf-cities { font-size: 0.86rem; color: var(--color-slate-500); }
  .nf-cities a { color: var(--color-blue-600); font-weight: 600; }
  @media (max-width: 820px) { .nf-grid { grid-template-columns: 1fr 1fr; } }
</style>
