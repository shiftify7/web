---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import CTABand from '@/components/CTABand.astro';
import { allServices, allCities } from '@/lib/data';
import { breadcrumbSchema, serviceSchema } from '@/lib/schema';

const [services, cities] = await Promise.all([allServices(), allCities()]);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }];
---
<BaseLayout
  title="Packers and Movers Services — House, Office, Car & More | Shiftify"
  description="House shifting, office relocation, car & bike transport, storage and international relocation — all delivered to one written, transparent standard."
  canonicalPath="/services/"
  jsonLd={[...services.map(serviceSchema), breadcrumbSchema(crumbs)]}
  quoteHref="/contact/#quote"
>
  <section class="section svc-index-hero">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <span class="kicker" style="margin-top:18px;display:inline-flex">Services</span>
      <h1>One standard of care, whatever you're moving</h1>
      <p class="lead">
        Every Shiftify service runs on the same rules: a written itemised quote, a supervisor-led crew,
        insured transit, and a bill that matches the quote. Available across {cities.map((c) => c.data.name).join(', ')}.
      </p>
      <div class="svc-grid">
        {
          services.map((s) => (
            <a class="svc card" href={`/services/${s.data.slug}/`}>
              <span class="svc-ic"><Icon name={s.data.icon} size={22} /></span>
              <h2>{s.data.name}</h2>
              <p>{s.data.short}</p>
              <span class="svc-go">Details &amp; FAQs <Icon name="arrow" size={14} /></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <CTABand heading="Not sure which service your move needs?" sub="Describe the move on WhatsApp — we'll scope it honestly, even if the honest answer is a smaller service." quoteHref="/contact/#quote" />
</BaseLayout>

<style>
  .svc-index-hero h1 { font-size: clamp(1.7rem, 3.4vw, 2.4rem); letter-spacing: -0.03em; margin: 12px 0 14px; }
  .lead { color: var(--color-slate-500); font-size: 0.98rem; max-width: 68ch; }
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 28px; }
  .svc { display: flex; flex-direction: column; gap: 10px; transition: border-color 180ms, box-shadow 180ms; }
  .svc:hover { border-color: var(--color-line-blue); box-shadow: 0 18px 36px -22px rgba(30, 58, 138, 0.28); }
  .svc-ic { width: 44px; height: 44px; display: grid; place-items: center; border-radius: var(--radius-s); background: var(--color-blue-50); color: var(--color-blue-600); border: 1px solid var(--color-line-blue); }
  .svc h2 { font-size: 1.08rem; }
  .svc p { font-size: 0.86rem; color: var(--color-slate-500); flex: 1; }
  .svc-go { display: inline-flex; align-items: center; gap: 6px; font-size: 0.84rem; font-weight: 600; color: var(--color-blue-600); }
  @media (max-width: 900px) { .svc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .svc-grid { grid-template-columns: 1fr; } }
</style>
